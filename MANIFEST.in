include LICENSE CHANGELOG.md README.md requirements.txt
recursive-include dylathleen/desktop *
recursive-exclude dylathleen/desktop *.orig
recursive-include dylathleen/view/resources *
recursive-exclude dylathleen/view/resources *.orig
recursive-include dylathleen/gems/*/resources *
recursive-exclude dylathleen/gems/*/resources *.orig
recursive-exclude linux_dist *
recursive-exclude venv *
recursive-exclude .venv *

prune dylathleen/gems/arch
prune dylathleen/gems/debian
