#!/bin/sh
set -eu
if [ "$1" = purge ]; then
    deb-systemd-helper purge dylathleen-refresh.timer >/dev/null
    rm -f /var/lib/dylathleen/inventory.json /etc/systemd/system/dylathleen-refresh.timer.d/interval.conf
    rmdir --ignore-fail-on-non-empty /etc/systemd/system/dylathleen-refresh.timer.d 2>/dev/null || true
    rmdir --ignore-fail-on-non-empty /var/lib/dylathleen 2>/dev/null || true
fi
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
