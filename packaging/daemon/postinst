#!/bin/sh
set -eu
if [ "$1" = configure ]; then
    install -d -m755 /var/lib/dylathleen
    if deb-systemd-helper --quiet was-enabled dylathleen-refresh.timer; then
        deb-systemd-helper enable dylathleen-refresh.timer >/dev/null
    else
        deb-systemd-helper update-state dylathleen-refresh.timer >/dev/null
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        if systemctl is-enabled --quiet dylathleen-refresh.timer; then
            deb-systemd-invoke start dylathleen-refresh.timer >/dev/null
        fi
    fi
fi
